#
# The service path is adapted to this port's vendor topology: the shipped
# reference ran from /odm/bin/hw/, but this port keeps its vendor HALs in
# /vendor/bin/hw/.
#
# The service is no longer a shim over the shipped liburcccore.so: that
# library drives Qualcomm-only nodes (/sys/class/kgsl/kgsl-3d0/...,
# /sys/class/devfreq/*qcom,devfreq*...) and faults on this MTK board. The
# rebuilt service owns the resource mapping and applies the equivalent tuning
# on the MediaTek nodes that exist.
#
service vendor.urcc-hal-aidl /vendor/bin/hw/vendor.oplus.hardware.urcc-service
    class hal
    user root
    group root readproc
    group system
    interface aidl vendor.oplus.hardware.urcc.IUrcc/default

on post-fs-data
    mkdir /data/vendor/urcc 0777 system system
    mkdir /data/vendor/uah 0777 system system

on property:vendor.urcc.debug=1
    mkdir /data/vendor/urcc 0777 system system
