#
# The vendor HAL runs from /vendor/bin/hw/ and owns its resource mapping,
# applying the equivalent tuning through the backing sysfs nodes.
#
service vendor.urcc-hal-aidl /vendor/bin/hw/vendor.oplus.hardware.urcc-service
    class hal
    user root
    group root readproc
    group system
    interface aidl vendor.oplus.hardware.urcc.IUrcc/default

on post-fs-data
    mkdir /data/vendor/urcc 0777 system system
    mkdir /data/vendor/uah 0777 system system

on property:vendor.urcc.debug=1
    mkdir /data/vendor/urcc 0777 system system
